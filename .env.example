# ── Age gate ──────────────────────────────────────────────────────────────────
# Cookie name used by middleware — keep in sync with middleware.ts
NEXT_PUBLIC_AGE_GATE_COOKIE=dorst-age-verified

# ── Locale ────────────────────────────────────────────────────────────────────
# Default locale served to new visitors before they set a preference.
# Supported: bg | en
NEXT_PUBLIC_DEFAULT_LOCALE=bg

# ── Analytics ─────────────────────────────────────────────────────────────────
# Vercel Analytics is injected automatically on Vercel — no key needed.
# If self-hosting, remove the <Analytics /> component from app/layout.tsx.

# ── Partner portal (ERP backend) ─────────────────────────────────────────────
# This is the ERP *HTTP origin*, not a secret from ERP _inputs/secrets.*.env.
# Local: whatever port dorst-erp-crm `npm run dev` prints (3000 if free, else 3001+).
# Production (dorst.top on Vercel): https://app.dorst.top
NEXT_PUBLIC_ERP_API_URL=http://localhost:3000

# ── Sandbox (staging website) ────────────────────────────────────────────────
# Vercel *Preview* env only: 1 shows the "Sandbox" banner and sets noindex.
# Ignored on production builds. Pair with NEXT_PUBLIC_ERP_API_URL pointing at
# the staging ERP (https://dorst-erp-crm.vercel.app) in the same Preview env.
NEXT_PUBLIC_SANDBOX=

# ── B2C checkout (Cloudflare Turnstile) ──────────────────────────────────────
# Same site key as ERP checkout if the Cloudflare widget allows dorst.top.
# Required for /shop/checkout Place order.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Partner feedback widget (pr-goblin → GitHub issues) ──────────────────────
# Server-only (no NEXT_PUBLIC_). Both set, plus NEXT_PUBLIC_ERP_API_URL above →
# signed-in partners get a Feedback tab; reports become PUBLIC issues on the repo.
# Token: fine-grained, this repo only, Issues read/write (+ Metadata read).
# Not the runner's token (that one is the GOBLIN_GH_TOKEN Actions secret).
# PR_GOBLIN_GITHUB_TOKEN=github_pat_...
# Random 32+ bytes, e.g. `openssl rand -hex 32`. Signs partner reports (trusted)
# and the feedback session cookie. Rotating it revokes both.
# PR_GOBLIN_TRUST_SECRET=
# PR_GOBLIN_GITHUB_REPO=Rumi-Shamz/dorst-web
