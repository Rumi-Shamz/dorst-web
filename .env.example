# ── Age gate ──────────────────────────────────────────────────────────────────
# Cookie name used by middleware — keep in sync with middleware.ts
NEXT_PUBLIC_AGE_GATE_COOKIE=dorst-age-verified

# ── Locale ────────────────────────────────────────────────────────────────────
# Default locale served to new visitors before they set a preference.
# Supported: bg | en
NEXT_PUBLIC_DEFAULT_LOCALE=bg

# ── Analytics ─────────────────────────────────────────────────────────────────
# Vercel Analytics is injected automatically on Vercel — no key needed.
# If self-hosting, remove the <Analytics /> component from app/layout.tsx.

# ── Partner portal (ERP backend) ─────────────────────────────────────────────
# This is the ERP *HTTP origin*, not a secret from ERP _inputs/secrets.*.env.
# Local: whatever port dorst-erp-crm `npm run dev` prints (3000 if free, else 3001+).
# Production (dorst.top on Vercel): https://app.dorst.top
NEXT_PUBLIC_ERP_API_URL=http://localhost:3000

# ── B2C checkout (Cloudflare Turnstile) ──────────────────────────────────────
# Same site key as ERP checkout if the Cloudflare widget allows dorst.top.
# Required for /shop/checkout Place order.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
